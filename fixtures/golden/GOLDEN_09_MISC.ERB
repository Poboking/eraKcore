; ============================================================================
; GOLDEN_09_MISC.ERB - skip/await/time/sound/debug statements
; isa.yaml: SKIPDISP NOSKIP ENDNOSKIP SKIPLOG FORCEKANA AWAIT GETTIME ASSERT
;   PLAYSOUND STOPSOUND PLAYBGM STOPBGM SETSOUNDVOLUME SETBGMVOLUME
; NOT covered (reasons in golden-runbook.md): QUIT FORCE_QUIT
;   QUIT_AND_RESTART FORCE_QUIT_AND_RESTART UPDATECHECK CALLTRAIN STOPCALLTRAIN
;   DOTRAIN ADDDEFCHARA SAVEVAR LOADVAR REF REFBYNAME SETBGIMAGE
;   REMOVEBGIMAGE CLEARBGIMAGE HTML_PRINT_ISLAND HTML_PRINT_ISLAND_CLEAR
;   PRINT_IMG PRINT_RECT PRINT_SPACE CLEARTEXTBOX TOOLTIP_* MOVETEXTBOX
;   RESUMETEXTBOX SETTEXTBOX GETTEXTBOX
; ============================================================================
@GOLDEN_MISC
	PRINTL === SECTION:SKIPDISP ===
	SKIPDISP 1
	PRINTFORML THIS-LINE-IS-HIDDEN
	SKIPDISP 0
	PRINTFORML SKIPDISP_RESULT={RESULT}
	PRINTFORML VISIBLE-AGAIN
	PRINTL === SECTION:NOSKIP ===
	SKIPLOG 1
	NOSKIP
	PRINTFORML NOSKIP-VISIBLE
	ENDNOSKIP
	SKIPLOG 0
	PRINTFORML AFTER-NOSKIP
	PRINTL === SECTION:FORCEKANA ===
	FORCEKANA 0
	PRINTFORML KANA0
	FORCEKANA 1
	PRINTFORML KANA1
	FORCEKANA 0
	PRINTL === SECTION:AWAIT ===
	AWAIT 100
	PRINTFORML AFTER-AWAIT
	PRINTL === SECTION:GETTIME ===
	GETTIME
	PRINTFORML GETTIME_RESULTS_LEN={STRLENSU(RESULTS)} NUMERIC={ISNUMERIC(RESULTS)}
	PRINTL === SECTION:ASSERT ===
	ASSERT 1
	PRINTFORML AFTER-ASSERT
	PRINTL === SECTION:SOUND-MISSING ===
	PLAYBGM "NO_SUCH_BGM_XYZ.mp3"
	PLAYSOUND "NO_SUCH_SE_XYZ.mp3", 1
	STOPSOUND
	STOPBGM
	SETSOUNDVOLUME 100
	SETBGMVOLUME 100
	PRINTFORML EXISTSOUND={EXISTSOUND("NO_SUCH_SE_XYZ.mp3")}
	; ISPLAYINGSOUND takes exactly one int (OmitStart=0); the zero-arg form
	; hits an engine NPE-class bug (arguments[0] read before the null check)
	PRINTFORML ISPLAYINGBGM={ISPLAYINGBGM()} ISPLAYINGSOUND={ISPLAYINGSOUND(0)}
	PRINTFORML SOUND-DONE
	PRINTL === SECTION:TOOLTIP ===
	TOOLTIP_SETCOLOR 0x00FF00, 0x0000FF
	TOOLTIP_SETDELAY 100
	TOOLTIP_SETDURATION 500
	TOOLTIP_SETFONT GETFONT()
	TOOLTIP_SETFONTSIZE 12
	TOOLTIP_CUSTOM 1
	TOOLTIP_FORMAT 0
	TOOLTIP_IMG 0
	TOOLTIP_CUSTOM 0
	PRINTFORML TOOLTIP-DONE
	PRINTL === SECTION:HOTKEY-MEMORY ===
	; HOTKEY_STATE(2-arg set form) throws unless HOTKEY_STATE_INIT ran first
	PRINTFORML HOTKEY_STATE_INIT={HOTKEY_STATE_INIT(2)}
	PRINTFORML HOTKEY_STATE={HOTKEY_STATE(1, 0)}
	CLEARMEMORY
	PRINTFORML MEMORY-DONE
	PRINTL === SECTION:RESETDATA ===
	FLAG:5 = 5
	RESETDATA
	; RESETDATA also clears chara slots; restore chara 0 before the console
	; repaints (it dereferences CALLNAME:0)
	ADDCHARA 0
	PRINTFORML AFTER-RESETDATA FLAG={FLAG:5}
	PRINTL === SECTION:WINDOW-TITLE ===
	WINDOW_TITLE '= "GOLDEN-TITLE"
	PRINTFORML WT=%WINDOW_TITLE%
	PRINTFORML END-MISC
	OUTPUTLOG "GOLDEN_LOG.txt"
