; ============================================================================
; GOLDEN_04_CHARA.ERB - character list operations and character data
; isa.yaml: ADDCHARA ADDVOIDCHARA DELCHARA SWAPCHARA COPYCHARA ADDCOPYCHARA
;   SORTCHARA PICKUPCHARA DELALLCHARA RESET_STAIN PRINT_ABL PRINT_TALENT
;   PRINT_MARK PRINT_EXP PRINT_PALAM PRINT_ITEM PRINT_SHOPITEM
; builtin-functions: GETCHARA FINDCHARA FINDLASTCHARA EXISTCSV CSVNAME
;   CSVCALLNAME CSVNICKNAME CSVBASE CSVABL CSVMARK CSVEXP CSVRELATION
;   CSVTALENT CSVCFLAG CSVEQUIP CSVJUEL CSVCSTR CMATCH SUMCARRAY MAXCARRAY
;   MINCARRAY INRANGECARRAY FIND_CHARADATA CHKCHARADATA
; NOTE: NOT covered here (needs the UP/PALAM settlement system, output shape
;   depends on game state machine): UPCHECK CUPCHECK. See golden-runbook.md.
; NOTE: SORTCHARA grammar = `SORTCHARA [chara-var-term], FORWARD|BACK`
;   (SP_SORTCHARA_ArgumentBuilder, ArgumentParser.cs:548-615: bare/no-arg
;   sorts by NO; direction keywords are FORWARD/BACK, not 0/1; the first
;   term must Restructure to a VariableTerm with IsCharacterData, :583-592).
;   Sort key: chara VAR token + element index
;   (SORTCHARA_Instruction, FunctionIdentifier.cs:1473-1486: for a 1D chara
;   var like CFLAG it reads GetElementInt(1), i.e. the SECOND index of the
;   global term, and CharacterData.SetSortKey, CharacterData.cs:807-817,
;   evaluates that element on EVERY chara - the chara slot of the term is
;   ignored and unchecked at load, VariableTerm.cs:323/CharaVariableToken
;   CheckElement :56-62). Hence `CFLAG:0:7` = "each chara's CFLAG(7)".
;   `CFLAG(7)` is NOT accepted: an identifier followed by `(` is parsed as
;   a function-method call (ExpressionParser.cs:363-389, ThrowException on
;   miss) and CFLAG is not a registered method (method/refmethod lookup,
;   IdentifierDictionary.cs:529-547) -> PC load warning, same-rejected line.
; ============================================================================
@GOLDEN_CHARA
	PRINTL === SECTION:CHARA-ADD ===
	ADDVOIDCHARA
	PRINTFORML VOIDNO={RESULT}
	ADDCHARA 0
	ADDCHARA 1
	PRINTFORML CHARANUM={CHARANUM}
	PRINTFORML GETCHARA0={GETCHARA(0)} GETCHARA1={GETCHARA(1)} GETCHARA999={GETCHARA(999)}
	PRINTFORML EXISTCSV0={EXISTCSV(0)} EXISTCSV999={EXISTCSV(999)}
	PRINTL === SECTION:CHARA-CSV ===
	PRINTFORML CSVNAME=%CSVNAME(0)%
	PRINTFORML CSVCALLNAME=%CSVCALLNAME(0)%
	PRINTFORML CSVNICKNAME=%CSVNICKNAME(0)%
	PRINTFORML CSVMASTERNAME=%CSVMASTERNAME(0)%
	PRINTFORML CSVBASE={CSVBASE(0,0)} CSVABL={CSVABL(0,0)} CSVMARK={CSVMARK(0,0)} CSVEXP={CSVEXP(0,0)}
	PRINTFORML CSVRELATION={CSVRELATION(0,1)} CSVTALENT={CSVTALENT(0,0)} CSVCFLAG={CSVCFLAG(0,0)} CSVEQUIP={CSVEQUIP(0,0)} CSVJUEL={CSVJUEL(0,0)}
	PRINTFORML CSVCSTR=%CSVCSTR(0,0)%
	PRINTL === SECTION:CHARA-DATA ===
	PRINTFORML NAME0=%NAME:0% CALLNAME0=%CALLNAME:0% NO0={NO:0}
	PRINTFORML BASE0_0={BASE:0:0} MAXBASE0_0={MAXBASE:0:0}
	ABL:0:0 = 5
	ABL:1:0 = 3
	CFLAG:0:7 = 42
	CFLAG:1:7 = 42
	CFLAG:2:7 = 9
	PRINTFORML ABL={ABL:0:0},{ABL:1:0} CFLAG={CFLAG:0:7},{CFLAG:1:7},{CFLAG:2:7}
	PRINTFORML FINDCHARA={FINDCHARA(CFLAG:0:7,42)} FINDLASTCHARA={FINDLASTCHARA(CFLAG:0:7,42)} MISS={FINDCHARA(CFLAG:0:7,999)} FROM1={FINDCHARA(CFLAG:0:7,42,1)}
	PRINTFORML CMATCH={CMATCH(CFLAG:0:7,42)} SUMCARRAY={SUMCARRAY(CFLAG:0:7,0,4)} MAXCARRAY={MAXCARRAY(CFLAG:0:7,0,4)} MINCARRAY={MINCARRAY(CFLAG:0:7,0,4)}
	PRINTFORML INRANGECARRAY={INRANGECARRAY(CFLAG:0:7,10,50,0,4)}
	PRINTL === SECTION:CHARA-PRINTDATA ===
	PRINT_ABL 0
	PRINT_TALENT 0
	PRINT_MARK 0
	PRINT_EXP 0
	PRINT_PALAM 0
	PRINTL === SECTION:CHARA-SORT-SWAP ===
	CFLAG:0:7 = 30
	CFLAG:1:7 = 20
	CFLAG:2:7 = 10
	SORTCHARA CFLAG:0:7, FORWARD
	PRINTFORML SORTASC={CFLAG:0:7},{CFLAG:1:7},{CFLAG:2:7}
	SORTCHARA CFLAG:0:7, BACK
	PRINTFORML SORTDESC={CFLAG:0:7},{CFLAG:1:7},{CFLAG:2:7}
	SWAPCHARA 0, 2
	PRINTFORML SWAPPED={CFLAG:0:7},{CFLAG:2:7}
	COPYCHARA 1, 0
	PRINTFORML COPIED={CFLAG:0:7},{CFLAG:1:7}
	ADDCOPYCHARA 0
	PRINTFORML ADDCOPY NUM={CHARANUM}
	PICKUPCHARA 0, 1
	PRINTFORML PICKUP NUM={CHARANUM}
	PRINTL === SECTION:CHARA-STAIN ===
	RESET_STAIN 0
	PRINTFORML STAIN0={STAIN:0:0}
	PRINTL === SECTION:CHARA-SHOP ===
	PRINT_ITEM
	PRINT_SHOPITEM
	PRINTL === SECTION:CHARA-DELETE ===
	DELCHARA 0
	PRINTFORML AFTER-DEL NUM={CHARANUM}
	DELALLCHARA
	; restore chara 0 at once: the console prompt dereferences CALLNAME:0
	; on the next repaint, and CHARANUM=0 makes that a hard error
	ADDCHARA 0
	PRINTFORML AFTER-DELALL NUM={CHARANUM}
