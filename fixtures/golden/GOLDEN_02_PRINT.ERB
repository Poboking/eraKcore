; ============================================================================
; GOLDEN_02_PRINT.ERB - PRINT family variants and console display statements
; isa.yaml: PRINT(all suffix variants) PRINT_DATA(single group) REUSELASTLINE CLEARLINE BAR
;   CUSTOMDRAWLINE DRAWLINE DRAWLINEFORM PRINTBUTTON(C/LC) PRINTPLAIN
;   SETCOLOR/RESETCOLOR SETBGCOLOR/RESETBGCOLOR SETCOLORBYNAME SETBGCOLORBYNAME
;   ALIGNMENT REDRAW FONTBOLD FONTITALIC FONTREGULAR FONTSTYLE SETFONT
;   HTML_PRINT HTML_TAGSPLIT DEBUGPRINT-family DEBUGCLEAR
; NOTE: all W-variants wait for a key press; each W-section is preceded by
;   SKIPLOG 1 so the wait is auto-skipped by the engine
;   (MesSkip=true + NeedValue=false, EmueraConsole.cs:1451).
; NOTE: the engine registers exactly the PRINT aliases listed in isa.yaml;
;   the PRINTSINGLE family has NO L/W suffixes (PRINTSINGLEL / PRINTSINGLEVL /
;   PRINTSINGLESL / PRINTSINGLEFORML / PRINTSINGLEFORMSL / PRINTSINGLEKL /
;   PRINTSINGLEVKL / PRINTSINGLESKL / PRINTSINGLEFORMKL / PRINTSINGLEFORMSKL /
;   PRINTSINGLEDL / PRINTSINGLEVDL / PRINTSINGLESDL / PRINTSINGLEFORMDL /
;   PRINTSINGLEFORMSDL do not exist and were removed; their non-L twins cover
;   the isa names). *FORMS* variants take a STRING expression (evaluated
;   first, then re-expanded as FORM at runtime), so their argument is quoted.
;   GETCOLOR/GETBGCOLOR/GETSTYLE/GETFONT/CURRENTALIGN/CURRENTREDRAW are
;   zero-arg METHODS and must appear with ().
; ============================================================================
@GOLDEN_PRINT
	#DIMS SDV
	#DIMS HTM
	#DIMS HSUB
	#DIM PCL
	#DIM SN, 100
	#DIM LC0
	PRINTL === SECTION:PRINT-NULL-L ===
	PRINT ABC
	PRINTL
	PRINTL DEF
	PRINTL === SECTION:PRINT-V-S ===
	PRINTV 1+2
	PRINTL
	PRINTVL 3*4
	PRINTS "STR"
	PRINTL
	PRINTSL "ABC"
	PRINTL === SECTION:PRINT-FORM ===
	PRINTFORM A={1+1}B
	PRINTL
	PRINTFORML C={2+2}
	PRINTFORMS "XY{3+3}"
	PRINTL
	PRINTFORMSL "Z{4+4}"
	PRINTL === SECTION:PRINT-K-D ===
	PRINTK 5
	PRINTL
	PRINTKL 6
	PRINTVK 7
	PRINTL
	PRINTVKL 8
	PRINTSK "KS"
	PRINTL
	PRINTSKL "KSL"
	PRINTFORMK K{9}
	PRINTL
	PRINTFORMKL KL{10}
	PRINTFORMSK "SK{11}"
	PRINTL
	PRINTFORMSKL "SKL{12}"
	PRINTD DBG
	PRINTL
	PRINTDL DBG2
	PRINTVD 13
	PRINTL
	PRINTVDL 14
	PRINTSD "SD"
	PRINTL
	PRINTSDL "SDL"
	PRINTFORMD D{15}
	PRINTL
	PRINTFORMDL DL{16}
	PRINTFORMSD "SDD{17}"
	PRINTL
	PRINTFORMSDL "SDDL{18}"
	PRINTL === SECTION:PRINT-SINGLE ===
	PRINTSINGLE ONE
	PRINTSINGLEV 19
	PRINTSINGLES "S3"
	PRINTSINGLEFORM F{21}
	PRINTSINGLEFORMS "FS{23}"
	PRINTSINGLEK K25
	PRINTSINGLEVK "VK27"
	PRINTSINGLESK "SK29"
	PRINTSINGLEFORMK FK31
	PRINTSINGLEFORMSK "FSK33"
	PRINTSINGLED D35
	PRINTSINGLEVD "VD37"
	PRINTSINGLESD "SD39"
	PRINTSINGLEFORMD FD41
	PRINTSINGLEFORMSD "FSD43"
	PRINTL === SECTION:PRINT-C ===
	PRINTC AA
	PRINTLC BB
	PRINTFORMC C{1}
	PRINTFORMLC D{2}
	PRINTCK EE
	PRINTLCK FF
	PRINTFORMCK G{3}
	PRINTFORMLCK H{4}
	PRINTCD II
	PRINTLCD JJ
	PRINTFORMCD K{5}
	PRINTFORMLCD L{6}
	PRINTL
	PRINTL === SECTION:PRINT-N ===
	PRINTN NN
	PRINTVN 45
	PRINTSN "NS"
	PRINTFORMN FN{46}
	PRINTFORMSN "FSN{47}"
	PRINTL
	PRINTFORML AFTER-PRINTN
	PRINTL === SECTION:PRINT-W ===
	SKIPLOG 1
	PRINTW WW
	PRINTVW 48
	PRINTSW "SW"
	PRINTFORMW FW{49}
	PRINTFORMSW "FSW{50}"
	PRINTKL KW51
	PRINTVKW "KW52"
	PRINTSKW "KW53"
	PRINTFORMKW KW54
	PRINTFORMSKW "KW55"
	PRINTDW DW56
	PRINTVDW "DW57"
	PRINTSDW "DW58"
	PRINTFORMDW DW59
	PRINTFORMSDW "DW60"
	PRINTKW KW61
	SKIPLOG 0
	PRINTL === SECTION:PRINT-DATA ===
	PRINTDATA
		DATA DAT1
	ENDDATA
	PRINTDATAL
		DATA DL1
		DATA DL2
	ENDDATA
	PRINTDATAK
		DATA DK1
	ENDDATA
	PRINTDATAD
		DATA DD1
	ENDDATA
	PRINTDATA
		DATAFORM DF{1+1}
	ENDDATA
	PRINTDATA
		DATALIST
			DATA G1L1
			DATA G1L2
		ENDLIST
	ENDDATA
	PRINTL === SECTION:STRDATA ===
	STRDATA SDV
		DATA SDA
		DATA SDB
	ENDDATA
	PRINTFORML SDV=%SDV%
	PRINTL === SECTION:LINE-CTRL ===
	; Absolute LINECOUNT depends on the game's title/menu history; print the
	; delta so CLEARLINE (-1) / REUSELASTLINE (0) stay comparable across hosts.
	LC0 = LINECOUNT
	PRINTFORML LINE-A
	PRINTFORML LINE-B
	PRINTFORML LINE-C
	CLEARLINE 1
	PRINTFORML AFTER-CLEAR LINE-DELTA={LINECOUNT-LC0}
	PRINTFORML LINE-D
	REUSELASTLINE REUSED-{1+1}
	PRINTFORML AFTER-REUSE LINE-DELTA={LINECOUNT-LC0}
	PRINTL === SECTION:BAR ===
	BAR 5, 10, 20
	PRINTL
	BARL 2, 8, 10
	PRINTFORML BARSTR_FUNC=%BARSTR(3,4,8)%
	PRINTL === SECTION:DRAWLINE ===
	CUSTOMDRAWLINE =
	DRAWLINE
	DRAWLINEFORM -{1+1}
	PRINTL === SECTION:BUTTON-PLAIN ===
	PRINTBUTTON "BTN", 1
	PRINTL
	PRINTBUTTON "[X]", "SVAL"
	PRINTL
	PRINTBUTTONC "BC", 2
	PRINTL
	PRINTBUTTONLC "BLC", 3
	PRINTL
	PRINTPLAIN PLAIN
	PRINTL
	PRINTPLAINFORM PF{7}
	PRINTL
	PRINTL === SECTION:COLOR ===
	SETCOLOR 0xFF0000
	PRINTFORML RED={GETCOLOR()}
	SETCOLOR 0, 128, 255
	PRINTFORML RGB={GETCOLOR()}
	SETCOLORBYNAME RED
	PRINTFORML BYNAME={GETCOLOR()} DEF={GETDEFCOLOR()} FOCUS={GETFOCUSCOLOR()}
	RESETCOLOR
	PRINTFORML RESET={GETCOLOR()}
	SETBGCOLOR 0x00FF00
	PRINTFORML BG={GETBGCOLOR()}
	SETBGCOLORBYNAME BLUE
	PRINTFORML BGBYNAME={GETBGCOLOR()} DEFBG={GETDEFBGCOLOR()}
	RESETBGCOLOR
	PRINTFORML BGRESET={GETBGCOLOR()}
	PRINTFORML COLOR_FROMNAME={COLOR_FROMNAME("RED")}
	PRINTFORML COLOR_FROMRGB={COLOR_FROMRGB(255, 0, 0)}
	PRINTL === SECTION:FONT-STYLE ===
	FONTBOLD
	PRINTFORML STYLE={GETSTYLE()}
	FONTITALIC
	PRINTFORML STYLE={GETSTYLE()}
	FONTSTYLE 4
	PRINTFORML STYLE={GETSTYLE()}
	FONTSTYLE 8
	PRINTFORML STYLE={GETSTYLE()}
	FONTREGULAR
	PRINTFORML STYLE={GETSTYLE()}
	SETFONT GETFONT()
	PRINTFORML FONT=%GETFONT()%
	SETFONT
	PRINTFORML FONT_DEFAULT=%GETFONT()%
	PRINTFORML CHKFONT={CHKFONT(GETFONT())}
	PRINTL === SECTION:ALIGNMENT ===
	PRINTFORML ALIGN0=%CURRENTALIGN()%
	ALIGNMENT CENTER
	PRINTFORML ALIGN1=%CURRENTALIGN()%
	ALIGNMENT RIGHT
	PRINTFORML ALIGN2=%CURRENTALIGN()%
	ALIGNMENT LEFT
	PRINTFORML ALIGN3=%CURRENTALIGN()%
	REDRAW 2
	PRINTFORML REDRAW={CURRENTREDRAW()}
	REDRAW 1
	PRINTFORML REDRAW={CURRENTREDRAW()}
	PRINTL === SECTION:CONFIG-QUERY ===
	PRINTCPERLINE PCL
	PRINTFORML PRINTCPERLINE={RESULT} PCL={PCL} FUNC={PRINTCPERLINE()}
	PRINTFORML PRINTCLENGTH={PRINTCLENGTH()}
	SAVENOS SN
	PRINTFORML SAVENOS_STMT={RESULT} SN0={SN:0} FUNC={SAVENOS()}
	PRINTL === SECTION:HTML ===
	HTML_PRINT "<b>HTML</b>PLAIN"
	PRINTL
	HTM '= "<i>AB</i>CD"
	HTML_TAGSPLIT HTM
	PRINTFORML TAGSPLIT_N={RESULT} R0=%RESULTS:0% R1=%RESULTS:1% R2=%RESULTS:2%
	PRINTFORML HTML_STRINGLEN={HTML_STRINGLEN("<i>AB</i>CD")} PLAIN={HTML_STRINGLEN("<i>AB</i>CD",1)}
	PRINTFORML HTML_TOPLAINTEXT=%HTML_TOPLAINTEXT("<i>AB</i>CD")%
	PRINTFORML HTML_ESCAPE=%HTML_ESCAPE("<a>")%
	PRINTFORML HTML_STRINGLINES={HTML_STRINGLINES("AAAA",2)}
	PRINTFORML HTML_GETPRINTEDSTR=[%HTML_GETPRINTEDSTR(0)%]
	PRINTFORML HTML_POPPRINTINGSTR=[%HTML_POPPRINTINGSTR()%]
	HSUB '= HTML_SUBSTRING("<i>AB</i>CD", 3)
	PRINTFORML HTML_SUBSTRING=[%HSUB%] R=%RESULTS:0%
	PRINTL === SECTION:LINE-QUERY ===
	PRINTFORML EMPTY={LINEISEMPTY()}
	PRINTFORML GETDISPLAYLINE=%GETDISPLAYLINE(0)%
	PRINTFORML ISSKIP={ISSKIP()} MESSKIP={MESSKIP()}
	PRINTL === SECTION:DEBUGPRINT ===
	DEBUGPRINT TO-DEBUG
	DEBUGPRINTL TO-DEBUG-L
	DEBUGPRINTFORM DF{8}
	DEBUGPRINTFORML DFL{9}
	DEBUGCLEAR
	PRINTFORML DEBUG-DONE
