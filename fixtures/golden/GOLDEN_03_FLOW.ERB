; ============================================================================
; GOLDEN_03_FLOW.ERB - control flow, calls, try-family, labels, events
; isa.yaml: IF ELSEIF ELSE ENDIF SIF SELECTCASE CASE CASEELSE ENDSELECT
;   FOR NEXT REPEAT REND WHILE WEND LOOP BREAK CONTINUE GOTO GOTOFORM TRYGOTO
;   TRYCGOTO TRYGOTOFORM TRYCGOTOFORM TRYGOTOLIST CALL CALLFORM TRYCALL
;   TRYCCALL TRYCJUMP TRYCCALLFORM JUMP JUMPFORM TRYJUMP TRYJUMPFORM
;   TRYCALLLIST TRYJUMPLIST CALLF CALLFORMF TRYCALLF TRYCALLFORMF RETURN
;   RETURNFORM RETURNF RESTART THROW CATCH ENDCATCH CALLEVENT FUNC ENDFUNC
; NOTE: BEGIN not exercised here (it switches the process state machine).
; NOTE: TRYCGOTO / TRYCGOTOFORM / TRYCJUMPFORM must appear lexically inside
;   a TRYCCALL...CATCH...ENDCATCH region of the same function (ErbLoader
;   funcMatch check). Under Emuera TRYC jump semantics the TRYCCALL target
;   must EXIST and return for the region body to execute, so all three are
;   exercised inside TRYCCALL GOLDEN_TRYC_HARNESS (a function that just
;   RETURNs); the TRYCGOTO/TRYCJUMPFORM cases then fall into the CATCH body.
; NOTE: function parameters are declared on the label line, corpus form
;   e.g. ANOTHER_TALK.ERB:119 "@MESSAGE_TALK(ARG,ARG:1,ARG:2)" (see also
;   BODY_INFO/ALTER_IMAGE_SET.ERB:17 "@AAZ_IMAGE_PREPARE_SINGLE(STR_IMAGE, GID)").
; NOTE: logical ops: && || ! are supported; "!!" is NOT (unary op directly
;   after unary op -> UnrecognizedSyntax), so double-negation uses "!(!x)".
; ============================================================================
@GOLDEN_FLOW
#DIM GCNT
	COUNT = 0
	GCNT = 0
	PRINTL === SECTION:IF-CHAIN ===
	IF 1 == 1
		PRINTFORML IF-BRANCH
	ELSEIF 2 == 2
		PRINTFORML ELSEIF-BRANCH
	ELSE
		PRINTFORML ELSE-BRANCH
	ENDIF
	IF 1 == 2
		PRINTFORML IF-BRANCH
	ELSEIF 2 == 2
		PRINTFORML ELSEIF-BRANCH2
	ELSE
		PRINTFORML ELSE-BRANCH
	ENDIF
	IF 1 == 2
		PRINTFORML IF-BRANCH
	ELSEIF 2 == 3
		PRINTFORML ELSEIF-BRANCH
	ELSE
		PRINTFORML ELSE-BRANCH2
	ENDIF
	SIF 1
		PRINTFORML SIF-TRUE
	SIF 0
		PRINTFORML SIF-FALSE
	PRINTFORML AFTER-SIF
	PRINTL === SECTION:SELECTCASE-INT ===
	SELECTCASE 2
		CASE 1
			PRINTFORML CASE-1
		CASE 2 TO 3
			PRINTFORML CASE-2TO3
		CASE 4
			PRINTFORML CASE-4
		CASEELSE
			PRINTFORML CASE-ELSE
	ENDSELECT
	SELECTCASE 9
		CASE 1
			PRINTFORML CASE-1
		CASE 2
			PRINTFORML CASE-2
		CASEELSE
			PRINTFORML CASE-ELSE2
	ENDSELECT
	PRINTL === SECTION:SELECTCASE-STR ===
	SELECTCASE "BB"
		CASE "AA"
			PRINTFORML SCASE-AA
		CASE "BB"
			PRINTFORML SCASE-BB
		CASEELSE
			PRINTFORML SCASE-ELSE
	ENDSELECT
	PRINTL === SECTION:FOR-NEXT ===
	FOR COUNT, 0, 3
		PRINTFORML F{COUNT}
	NEXT
	PRINTFORML AFTER-FOR COUNT={COUNT}
	FOR COUNT, 0, 6, 2
		PRINTFORML FS{COUNT}
	NEXT
	FOR COUNT, 3, 0, -1
		PRINTFORML FD{COUNT}
	NEXT
	FOR COUNT, 3, 3
		PRINTFORML NEVER
	NEXT
	PRINTFORML AFTER-ZERO-FOR COUNT={COUNT}
	PRINTL === SECTION:REPEAT ===
	REPEAT 3
		PRINTFORML R{COUNT}
	REND
	REPEAT 3
		SIF COUNT == 1
			CONTINUE
		PRINTFORML RC{COUNT}
	REND
	REPEAT 5
		IF COUNT == 2
			BREAK
		ENDIF
		PRINTFORML RB{COUNT}
	REND
	PRINTFORML AFTER-REPEAT COUNT={COUNT}
	PRINTL === SECTION:WHILE ===
	COUNT = 0
	WHILE COUNT < 3
		PRINTFORML W{COUNT}
		COUNT = COUNT + 1
	WEND
	WHILE 0
		PRINTFORML NEVER
	WEND
	PRINTFORML AFTER-WHILE COUNT={COUNT}
	PRINTL === SECTION:DO-LOOP ===
	COUNT = 0
	DO
		PRINTFORML D{COUNT}
		COUNT = COUNT + 1
	LOOP COUNT < 3
	DO
		PRINTFORML DO-ONCE
	LOOP 0
	PRINTFORML AFTER-DO COUNT={COUNT}
	PRINTL === SECTION:WHILE-BREAK-CONT ===
	COUNT = 0
	WHILE 1
		COUNT = COUNT + 1
		IF COUNT == 2
			CONTINUE
		ENDIF
		IF COUNT == 4
			BREAK
		ENDIF
		PRINTFORML WB{COUNT}
	WEND
	PRINTFORML AFTER-WHILE-BREAK COUNT={COUNT}
	PRINTL === SECTION:GOTO ===
	GOTO LAB1
	PRINTFORML NEVER-GOTO
	$LAB1
	PRINTFORML AT-LAB1
	GOTOFORM LAB{1+1}
	PRINTFORML NEVER-GOTOFORM
	$LAB2
	PRINTFORML AT-LAB2
	TRYGOTO NOLAB_XYZ
	PRINTFORML AFTER-TRYGOTO
	TRYGOTOFORM LAB{99+1}
	PRINTFORML AFTER-TRYGOTOFORM
	TRYCCALL GOLDEN_TRYC_HARNESS
		TRYCGOTO NOLAB_XYZ
		PRINTFORML NEVER-AFTER-TRYCGOTO
		CATCH
			PRINTFORML CAUGHT-TRYCGOTO
		ENDCATCH
	CATCH
		PRINTFORML CAUGHT-TRYCCALL
	ENDCATCH
	PRINTFORML AFTER-TRYCGOTO
	GOTO LAB3
	$LAB17
	PRINTFORML AT-LAB17
	GOTO LAB4
	$LAB3
	TRYCCALL GOLDEN_TRYC_HARNESS
		TRYCGOTOFORM LAB{10+10}
		PRINTFORML NEVER-AFTER-TRYCGOTOFORM
		$LAB20
		PRINTFORML TRYCGOTOFORM-OK
		CATCH
			PRINTFORML CAUGHT-TRYCGOTOFORM
		ENDCATCH
	CATCH
		PRINTFORML CAUGHT-TRYCCALL-2
	ENDCATCH
	PRINTFORML AFTER-TRYCGOTOFORM
	GOTO LAB4
	$LAB4
	PRINTL === SECTION:TRYGOTOLIST ===
	TRYGOTOLIST
		FUNC NOLAB_A
		FUNC LAB5
		FUNC LAB6
	ENDFUNC
	$LAB5
	PRINTFORML AT-LAB5
	GOTO LAB7
	$LAB6
	PRINTFORML NEVER-LAB6
	$LAB7
	PRINTFORML AFTER-TRYGOTOLIST
	PRINTL === SECTION:CALL-RETURN ===
	CALL GOLDEN_SUB, 1, 2
	PRINTFORML AFTER-CALL R0={RESULT:0} R1={RESULT:1} R2={RESULT:2}
	CALLFORM GOLDEN_S{1+1}, 3
	PRINTFORML AFTER-CALLFORM R={RESULT:0}
	TRYCALL GOLDEN_NOFUNC_XYZ
	PRINTFORML AFTER-TRYCALL
	TRYCALLFORM GOLDEN_NO{1+1}, 5
	PRINTFORML AFTER-TRYCALLFORM
	TRYCCALL GOLDEN_NOFUNC_XYZ
		PRINTFORML TRY-BODY
	CATCH
		PRINTFORML TRYC-CATCH-CALL
	ENDCATCH
	PRINTFORML AFTER-TRYCCALL
	TRYCCALL GOLDEN_TRYC_HARNESS
		TRYCJUMPFORM GOLDEN_NO{1+1}
		PRINTFORML NEVER-AFTER-TRYCJUMPFORM
		CATCH
			PRINTFORML CAUGHT-TRYCJUMPFORM
		ENDCATCH
	CATCH
		PRINTFORML CAUGHT-TRYCCALL-3
	ENDCATCH
	PRINTFORML AFTER-TRYCJUMPFORM
	CALL GOLDEN_THROWER_CATCH
	PRINTL === SECTION:JUMP ===
	TRYJUMP GOLDEN_JUMPTARGET
	PRINTFORML NEVER-AFTER-TRYJUMP
@GOLDEN_SUB(ARG, ARG:1)
	PRINTFORML SUB-ARGS {ARG} {ARG:1}
	RETURN 10, 20, 30
@GOLDEN_SUB2(ARG)
	PRINTFORML SUB2-ARG {ARG}
	RETURN 40
@GOLDEN_TRYC_HARNESS
	RETURN
@GOLDEN_THROWER
	THROW BOOM-MESSAGE
@GOLDEN_THROWER_CATCH
#DIM GCNT
	TRYCCALL GOLDEN_NOFUNC_XYZ
		PRINTFORML NEVER-THROW-BODY
	CATCH
		PRINTFORML CAUGHT-MISSING-CALL
	ENDCATCH
	GCNT = GCNT + 1
	SIF GCNT < 3
		RESTART
	PRINTFORML RESTART-DONE COUNT={GCNT}
	PRINTL === SECTION:JUMP2 ===
@GOLDEN_JUMPTARGET
	PRINTFORML AT-JUMPTARGET
	JUMPFORM GOLDEN_JUMPTARGET{1+1}
	PRINTFORML NEVER-AFTER-JUMPFORM
@GOLDEN_JUMPTARGET2
	PRINTFORML AT-JUMPTARGET2
	TRYJUMPLIST
		FUNC GOLDEN_NOFUNC_A
		FUNC GOLDEN_NOFUNC_B
		FUNC GOLDEN_LISTEND
	ENDFUNC
	PRINTFORML NEVER-AFTER-TRYJUMPLIST
@GOLDEN_LISTEND
	PRINTFORML AT-LISTEND
	PRINTL === SECTION:TRYCALLLIST ===
	TRYCALLLIST
		FUNC GOLDEN_NOFUNC_C
		FUNC GOLDEN_LISTCALLED, 5
	ENDFUNC
	PRINTFORML AFTER-TRYCALLLIST R={RESULT:0}
	PRINTL === SECTION:CALLF ===
	CALLF GOLDEN_FFUNC, 3
	PRINTFORML CALLF-RESULT {RESULT:0}
	CALLFORMF GOLDEN_FF{1+1}, 4
	PRINTFORML CALLFORMF-RESULT {RESULT:0}
	TRYCALLF GOLDEN_NOFUNC_F
	PRINTFORML AFTER-TRYCALLF
	TRYCALLFORMF GOLDEN_NOF{1+1}
	PRINTFORML AFTER-TRYCALLFORMF
	PRINTL === SECTION:CALLEVENT ===
	; Original build rejects CALLEVENT while an event function is running
	; ("EVENT函数结束前执行了CALLEVENT命令"), and this suite is entered from
	; @EVENTFIRST, so the statement is unobservable here.
	PRINTFORML SKIP-CALLEVENT-EVENT-FUNC
	PRINTL === SECTION:LOGIC-OPS ===
	PRINTFORML AND={1 && 1} {1 && 0} OR={0 || 1} {0 || 0} NOT={!0}
	PRINTFORML DOUBLENEG={!(!0)} XOR={1 ^^ 0}
	PRINTFORML CMP={1 < 2} {2 <= 2} {3 > 4} {4 >= 4} {5 == 5} {5 != 5}
	PRINTFORML STRCMP={"AA" == "AA"} {"AA" != "BB"}
	PRINTL === SECTION:RETURNFORM ===
	CALL GOLDEN_RETFORM
	PRINTFORML RF={RESULT:0},{RESULT:1}
@GOLDEN_LISTCALLED(ARG)
	PRINTFORML LISTCALLED {ARG}
	RETURN 6
@GOLDEN_FFUNC(ARG)
	#FUNCTION
	RESULT:0 = ARG * ARG
	RETURNF RESULT:0
@GOLDEN_FF2(ARG)
	#FUNCTION
	RETURNF ARG + 100
@GOLDEN_RETFORM
	RETURNFORM {10+1}, {2+1}
@GOLDEN_S2(ARG)
	PRINTFORML S2-ARG {ARG}
	RETURN 77
@EVENTEND
	PRINTFORML EV1
@EVENTEND
	PRINTFORML EV2
