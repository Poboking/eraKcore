; ============================================================================
; GOLDEN_11_GVIEW.ERB - graphics buffers / sprites / console background
; builtin-functions.yaml view category (buffer-state query and drawing calls
;   whose RETURN VALUES are deterministic; pixel rendering itself is NOT
;   diffed via text logs).
; NOTE: CLIENTWIDTH/CLIENTHEIGHT depend on the window size. Keep the window
;   at its startup size (emuera.config fixes width 1800) when capturing.
; NOTE: CLIENTWIDTH/CLIENTHEIGHT/GETFONT are zero-arg METHODS (must be
;   called with ()); GFILLRECTANGLE takes exactly 5 ints
;   (id, x, y, width, height - color comes from GSETBRUSH); GDASHSTYLE takes
;   exactly 3 ints (id, dashstyle, custom-pattern). GGETFONT returns STRING.
; ============================================================================
@GOLDEN_GVIEW
	PRINTL === SECTION:G-BUFFER ===
	PRINTFORML GCREATE={GCREATE(10, 100, 60)}
	PRINTFORML GCREATED={GCREATED(10)} MISS={GCREATED(999)}
	PRINTFORML GWIDTH={GWIDTH(10)} GHEIGHT={GHEIGHT(10)}
	PRINTFORML GCLEAR={GCLEAR(10, 0x0000FF)}
	PRINTFORML GSETBRUSH={GSETBRUSH(10, 0x00FF00)}
	PRINTFORML GFILLRECT={GFILLRECTANGLE(10, 10, 10, 20, 20)}
	PRINTFORML GSETCOLOR={GSETCOLOR(10, 5, 5, 0xFF0000)}
	PRINTFORML GGETCOLOR={GGETCOLOR(10, 5, 5)}/{GGETCOLOR(10, 0, 0)}
	PRINTFORML GGETBRUSH={GGETBRUSH(10)}
	PRINTFORML GSETPEN={GSETPEN(10, 0x654321, 3)} GGETPEN={GGETPEN(10)} W={GGETPENWIDTH(10)}
	PRINTFORML GDRAWLINE={GDRAWLINE(10, 0, 0, 50, 30)}
	PRINTFORML GSETFONT={GSETFONT(10, GETFONT(), 16, 1)}
	PRINTFORML GGETFONT=%GGETFONT(10)% SIZE={GGETFONTSIZE(10)} STYLE={GGETFONTSTYLE(10)}
	PRINTFORML GDRAWTEXT={GDRAWTEXT(10, "HELLO", 0, 0)}
	; GLOAD returns 0 when the destination buffer already exists
	; (FunctionMethodCreator.cs:8154-8158), so loading from img0000.png into
	; buffer 10 was a guaranteed 0; use fresh id 17 to reach the success path.
	PRINTFORML GSAVE={GSAVE(10, 0)} GLOAD={GLOAD(17, 0)}
	PRINTFORML GLOAD_DISPOSE={GDISPOSE(17)}
	PRINTFORML GDISPOSE14={GDISPOSE(14)}
	PRINTFORML GDRAWG={GDRAWG(10, 10, 30, 0, 20, 20, 0, 0, 20, 20)}
	PRINTFORML GDRAWGWITHROTATE={GDRAWGWITHROTATE(10, 10, 0, 0, 45)}
	PRINTFORML GCREATE_MASK={GCREATE(14, 20, 20)}
	; src and mask must share dimensions (FunctionMethodCreator.cs:7333-7336).
	; (10,10,14) exercises the mismatch branch; id 15 is a size-matched source.
	PRINTFORML GDRAWGWITHMASK_MISMATCH={GDRAWGWITHMASK(10, 10, 14, 0, 0)}
	PRINTFORML GCREATE_SRC={GCREATE(15, 20, 20)}
	PRINTFORML GDRAWGWITHMASK={GDRAWGWITHMASK(10, 15, 14, 0, 0)}
	PRINTFORML GDASHSTYLE={GDASHSTYLE(10, 0, 0)}
	PRINTFORML GDISPOSE={GDISPOSE(10)}
	PRINTL === SECTION:SPRITE ===
	PRINTFORML GCREATE2={GCREATE(11, 40, 20)}
	PRINTFORML SPRITECREATE={SPRITECREATE("GSPR", 11)}
	PRINTFORML SPRITECREATED={SPRITECREATED("GSPR")} MISS={SPRITECREATED("NO_SUCH_SPR_XYZ")}
	PRINTFORML GDRAWSPRITE={GDRAWSPRITE(11, "GSPR", 0, 0)}
	; Last arg is a nonzero int depth (int.MinValue..int.MaxValue except 0):
	; FunctionMethodCreator.cs:7736-7738 (CBGSETSPRITE), :7787-7790 (button).
	PRINTFORML CBGSETSPRITE={CBGSETSPRITE("GSPR", 0, 0, 1)}
	PRINTFORML CBGSETBUTTONSPRITE={CBGSETBUTTONSPRITE(1, "GSPR", "GSPR", 0, 0, 1, "TIP")}
	PRINTFORML SPRITEWIDTH={SPRITEWIDTH("GSPR")} HEIGHT={SPRITEHEIGHT("GSPR")}
	PRINTFORML SPRITEPOS={SPRITEPOSX("GSPR")},{SPRITEPOSY("GSPR")}
	PRINTFORML SPRITEMOVE={SPRITEMOVE("GSPR", 5, 7)} POS={SPRITEPOSX("GSPR")},{SPRITEPOSY("GSPR")}
	PRINTFORML SPRITESETPOS={SPRITESETPOS("GSPR", 1, 2)} POS={SPRITEPOSX("GSPR")},{SPRITEPOSY("GSPR")}
	PRINTFORML SPRITEGETCOLOR={SPRITEGETCOLOR("GSPR", 0, 0)}
	PRINTFORML SPRITEDISPOSE={SPRITEDISPOSE("GSPR")}
	PRINTFORML SPRITEDISPOSEALL={SPRITEDISPOSEALL(0)}
	PRINTL === SECTION:SPRITE-ANIME ===
	PRINTFORML GCREATE3={GCREATE(12, 10, 10)}
	PRINTFORML ANIMECREATE={SPRITEANIMECREATE("GANM", 10, 10)}
	PRINTFORML ANIMEADDFRAME={SPRITEANIMEADDFRAME("GANM", 12, 0, 0, 10, 10, 0, 0, 100)}
	PRINTFORML SETANIMETIMER={SETANIMETIMER(100)}
	PRINTL === SECTION:CBG ===
	PRINTFORML GCREATE4={GCREATE(13, 50, 50)}
	PRINTFORML CBGSETG={CBGSETG(13, 0, 0, 1)}
	PRINTFORML CBGREMOVERANGE={CBGREMOVERANGE(0, 10)}
	PRINTFORML CBGSETBMAPG={CBGSETBMAPG(13)}
	PRINTFORML CBGCLEARBUTTON={CBGCLEARBUTTON()}
	PRINTFORML CBGREMOVEBMAP={CBGREMOVEBMAP()}
	PRINTFORML CBGCLEAR={CBGCLEAR()}
	PRINTFORML GDISPOSE13={GDISPOSE(13)}
	PRINTL === SECTION:WINDOW ===
	PRINTFORML CLIENTWIDTH={CLIENTWIDTH()}
	PRINTFORML CLIENTHEIGHT={CLIENTHEIGHT()}
	PRINTFORML BITMAPCACHE={BITMAP_CACHE_ENABLE(1)}
	PRINTFORML END-GVIEW
