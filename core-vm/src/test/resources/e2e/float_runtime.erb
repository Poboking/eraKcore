; ---------------------------------------------------------------------------
; 浮点运行期端到端片段（worker f4）。只抄真实语料调用点的写法，不改真实语料。
;
; 证据（真实语料调用点）：
;   DLC/魔法DLC/使用魔法.ERB:1248     LOCALF = 0.0
;   DLC/魔法DLC/使用魔法.ERB:1250     LOCALF += YOGORE:(LOCAL) * 0.01
;   DLC/魔法DLC/使用魔法.ERB:1256     经验获取量 = TOINT(LOCALF)
;   DLC/魔法DLC/魔法相关函数.ERB:3190  #DIMF DYNAMIC 倍率
;   DLC/魔法DLC/魔法相关函数.ERB:3214  倍率 = 1.0
;   DLC/魔法DLC/魔法相关函数.ERB:3216  倍率 *= 1.2（本片段取 2.0，便于整数见证精确对值）
;
; 见证变量一律用内建整型系统变量 A/B/C（SystemLayout.int1D），这样跑完后装置可按名
; 读回整型读数；每个函数由独立用例单独跑，互不串状态。
; ---------------------------------------------------------------------------

@LOCALF_ACCUM
	A = 125
	LOCALF = 0.0
	LOCALF += A * 0.01
	B = TOINT(LOCALF)
	C = TOINT(LOCALF * 100)

@RATE_SCALE
#DIMF DYNAMIC 倍率
	倍率 = 1.0
	倍率 *= 2.0
	B = TOINT(倍率 * 100)
	C = 倍率 > 1.9

@ARGF_RW
	ARGF:0 = 0.25
	ARGF:3 = -1.5
	B = TOINT(ARGF:0 * 100)
	C = TOINT(ARGF:3 * 100)
